{
  "format_version": "1.2",
  "terraform_version": "1.6.0",
  "resource_changes": [
    {
      "address": "aws_rds_cluster.main",
      "type": "aws_rds_cluster",
      "change": {
        "actions": ["create"],
        "before": null,
        "after": {
          "cluster_identifier": "main",
          "engine": "aurora-mysql",
          "engine_mode": "provisioned",
          "serverlessv2_scaling_configuration": [
            { "min_capacity": 0.5, "max_capacity": 8 }
          ]
        },
        "after_unknown": { "id": true, "arn": true, "endpoint": true }
      }
    }
  ],
  "configuration": {
    "provider_config": {
      "aws": { "expressions": { "region": { "constant_value": "us-east-1" } } }
    }
  }
}
